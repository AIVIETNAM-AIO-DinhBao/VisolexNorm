{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelBTrainConfig",
  "type": "object",
  "additionalProperties": true,
  "required": ["run_type", "initial_checkpoint", "checkpoint_inventory_sha256", "phase3_manifest_sha256", "training_mixture_manifest_sha256", "gold_checksum", "dev_checksum", "weak_label_checksum", "seed", "gold_count", "dev_count", "weak_label_count", "pseudo_per_epoch", "gold_pseudo_ratio", "completion_status", "prompt_version", "decision_distribution", "source_distribution", "epoch_seeds", "replacement_used", "hyperparameters", "runtime", "best_checkpoint", "best_dev_loss"],
  "properties": {
    "run_type": {"enum": ["smoke_test", "full"]},
    "initial_checkpoint": {"type": "string", "minLength": 1},
    "model_a_bundle_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "checkpoint_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "phase3_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "training_mixture_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "gold_checksum": {"$ref": "#/$defs/sha256"},
    "dev_checksum": {"$ref": "#/$defs/sha256"},
    "seed": {"const": 2026},
    "gold_count": {"const": 8372},
    "dev_count": {"const": 1050},
    "weak_label_count": {"const": 18970},
    "pseudo_per_epoch": {"const": 8372},
    "gold_pseudo_ratio": {"const": "1:1"},
    "weak_label_checksum": {"$ref": "#/$defs/sha256"},
    "completion_status": {"const": "completed_with_approved_provider_exclusions"},
    "prompt_version": {"const": "lexical_norm_review_v1"},
    "decision_distribution": {"type": "object", "required": ["KEEP", "EDIT"], "properties": {"KEEP": {"type": "integer", "minimum": 0}, "EDIT": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "source_distribution": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "epoch_seeds": {"const": [2026, 2027, 2028]},
    "replacement_used": {"type": "boolean"},
    "hyperparameters": {"type": "object"},
    "runtime": {"type": "object", "required": ["python_version", "torch_version", "transformers_version", "device"]},
    "best_checkpoint": {"type": "string", "minLength": 1},
    "best_dev_loss": {"type": "number", "minimum": 0}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}