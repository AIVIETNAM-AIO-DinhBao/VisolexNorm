{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GeminiReviewRequestPayload",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompt_version", "samples"],
  "properties": {
    "prompt_version": {"enum": ["lexical_norm_review_draft", "lexical_norm_review_v1"]},
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "candidate"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "candidate": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}