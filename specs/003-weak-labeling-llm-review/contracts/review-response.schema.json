{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GeminiReviewResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "decision", "corrected_text", "reason_code"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "decision": {"const": "KEEP"},
              "corrected_text": {"type": "null"},
              "reason_code": {"type": "null"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "decision", "corrected_text", "reason_code"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "decision": {"const": "EDIT"},
              "corrected_text": {"type": "string", "minLength": 1},
              "reason_code": {"type": "null"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "decision", "corrected_text", "reason_code"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "decision": {"const": "REJECT"},
              "corrected_text": {"type": "null"},
              "reason_code": {
                "enum": ["AMBIGUOUS", "MEANING_UNCERTAIN", "CANDIDATE_UNUSABLE", "NOT_LEXICAL_NORMALIZATION", "OTHER"]
              }
            }
          }
        ]
      }
    }
  }
}