{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeakLabelRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "dataset", "original_source", "input_text", "candidate_text",
    "model_a_confidence", "confidence_band", "llm_decision",
    "llm_corrected_text", "target_text", "label_source", "llm_model",
    "prompt_version", "accepted"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "dataset": {"const": "ViSoLex"},
    "original_source": {"type": "string", "minLength": 1},
    "input_text": {"type": "string", "minLength": 1},
    "candidate_text": {"type": "string", "minLength": 1},
    "model_a_confidence": {"type": "number"},
    "confidence_band": {"enum": ["low", "medium", "high"]},
    "llm_decision": {"enum": ["KEEP", "EDIT"]},
    "llm_corrected_text": {"type": ["string", "null"]},
    "target_text": {"type": "string", "minLength": 1},
    "label_source": {"const": "model_a+llm_review"},
    "llm_model": {"type": "string", "minLength": 1},
    "prompt_version": {"const": "lexical_norm_review_v1"},
    "accepted": {"const": true}
  }
}