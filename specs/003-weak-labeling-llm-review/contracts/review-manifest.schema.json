{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewManifestItem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "dataset", "original_source", "input_text", "candidate_text",
    "model_a_confidence", "candidate_checkpoint", "generation_config_hash",
    "sequence_token_count", "generation_status", "confidence_band", "source_quota",
    "selection_rank", "selection_seed", "is_pilot"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "dataset": {"const": "ViSoLex"},
    "original_source": {
      "enum": ["ViHSD", "UIT-VSMEC", "ViHOS", "ViSpamReviews", "UIT-ViSFD"]
    },
    "input_text": {"type": "string", "minLength": 1},
    "candidate_text": {"type": "string"},
    "model_a_confidence": {"type": "number"},
    "candidate_checkpoint": {"type": "string", "minLength": 1},
    "generation_config_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sequence_token_count": {"type": "integer", "minimum": 1},
    "generation_status": {"enum": ["generated_text", "empty_after_special_token_decode"]},
    "confidence_band": {"enum": ["low", "medium", "high"]},
    "source_quota": {"type": "integer", "minimum": 1},
    "selection_rank": {"type": "integer", "minimum": 1},
    "selection_seed": {"const": 2026},
    "is_pilot": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"generation_status": {"const": "generated_text"}}},
      "then": {"properties": {"candidate_text": {"minLength": 1}}}
    },
    {
      "if": {"properties": {"generation_status": {"const": "empty_after_special_token_decode"}}},
      "then": {"properties": {"candidate_text": {"maxLength": 0}}}
    }
  ]
}