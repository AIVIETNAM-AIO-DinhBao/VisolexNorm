{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CandidateRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "dataset", "original_source", "input_text", "candidate_text",
    "model_a_confidence", "candidate_checkpoint", "generation_config_hash",
    "sequence_token_count"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "dataset": {"const": "ViSoLex"},
    "original_source": {
      "enum": ["ViHSD", "UIT-VSMEC", "ViHOS", "ViSpamReviews", "UIT-ViSFD"]
    },
    "input_text": {"type": "string", "minLength": 1},
    "candidate_text": {"type": "string", "minLength": 1},
    "model_a_confidence": {"type": "number"},
    "candidate_checkpoint": {"type": "string", "minLength": 1},
    "generation_config_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sequence_token_count": {"type": "integer", "minimum": 1}
  }
}