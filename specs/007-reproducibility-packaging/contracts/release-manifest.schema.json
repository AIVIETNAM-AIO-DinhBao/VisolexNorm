{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReleaseManifest",
  "type": "object",
  "required": ["project", "version", "created_at", "source_revision", "release_status", "artifacts"],
  "properties": {
    "project": {"const": "ViSoLexNorm"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "release_status": {"enum": ["candidate_pending_checkpoint_distribution", "released"]},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "phase", "artifact_type", "kind", "location", "sha256", "size_bytes", "required", "distribution_url", "contains_sensitive_data"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
          "phase": {"type": "integer", "minimum": 1, "maximum": 10},
          "artifact_type": {"enum": ["code", "config", "prompt", "data", "checkpoint", "metrics", "predictions", "docs"]},
          "kind": {"enum": ["file", "directory"]},
          "location": {"enum": ["repository", "local-handoff", "external"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "required": {"type": "boolean"},
          "distribution_url": {"type": ["string", "null"]},
          "contains_sensitive_data": {"const": false}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}